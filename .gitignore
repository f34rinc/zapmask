# ANATEL / ABR Telecom EASI source dumps — never commit (public data, but
# large, dated, and redistributed by the user, not this repo). Users download
# their own from https://easi.abrtelecom.com.br/nsapn/#/public/files
SMP_*.txt
STFC_*.txt
*_GERAL.txt
# Any .txt dropped in the project root (dumps land here for drag-and-drop);
# anchored to root so tracked .txt in subdirs (examples/) are unaffected.
/*.txt
# ...but keep the synthetic sample files shipped for docs/testing
!examples/SMP_sample.txt
!examples/STFC_sample.txt

# Generated mask output (default --out directory)
masks/

# Python
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/

# Internal design/planning artifacts — kept local, not shipped
docs/
